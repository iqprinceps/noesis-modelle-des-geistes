Dialogue: 3,0:00:00.00,0:00:42.28,Badge,,0,0,0,,SCHLAFPARALYSE  ·  1/6
Dialogue: 4,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(160,260)}DU ERSTICKST\NNICHT
Dialogue: 0,0:00:00.30,0:00:01.02,Caption,,0,0,0,,Du wachst auf
Dialogue: 0,0:00:01.06,0:00:01.78,Caption,,0,0,0,,und bekommst keine
Dialogue: 0,0:00:01.86,0:00:02.16,Caption,,0,0,0,,Luft.
Dialogue: 0,0:00:02.90,0:00:03.40,Caption,,0,0,0,,Das fühlt sich
Dialogue: 0,0:00:03.46,0:00:04.22,Caption,,0,0,0,,an wie Ersticken.
Dialogue: 0,0:00:05.04,0:00:05.50,Caption,,0,0,0,,Es ist aber
Dialogue: 0,0:00:05.60,0:00:05.96,Caption,,0,0,0,,keins.
Dialogue: 0,0:00:06.40,0:00:07.72,Caption,,0,0,0,,Im REM-Schlaf schaltet
Dialogue: 0,0:00:07.76,0:00:08.40,Caption,,0,0,0,,dein Gehirn die
Dialogue: 0,0:00:08.46,0:00:09.28,Caption,,0,0,0,,Muskeln ab, die
Dialogue: 0,0:00:09.34,0:00:10.12,Caption,,0,0,0,,du sonst selbst
Dialogue: 0,0:00:10.22,0:00:10.72,Caption,,0,0,0,,steuerst.
Dialogue: 0,0:00:11.42,0:00:12.70,Caption,,0,0,0,,Arme, Beine, Nacken.
Dialogue: 0,0:00:13.32,0:00:14.42,Caption,,0,0,0,,Dein Zwerchfell schaltet
Dialogue: 0,0:00:14.46,0:00:15.10,Caption,,0,0,0,,es nicht ab.
Dialogue: 0,0:00:15.72,0:00:16.32,Caption,,0,0,0,,Du atmest die
Dialogue: 0,0:00:16.36,0:00:17.28,Caption,,0,0,0,,ganze Zeit weiter,
Dialogue: 0,0:00:17.56,0:00:18.14,Caption,,0,0,0,,nur flacher.
Dialogue: 0,0:00:18.72,0:00:19.06,Caption,,0,0,0,,Und wenn du
Dialogue: 0,0:00:19.12,0:00:19.82,Caption,,0,0,0,,wach bist und
Dialogue: 0,0:00:19.92,0:00:21.10,Caption,,0,0,0,,Panik hast, fühlt
Dialogue: 0,0:00:21.16,0:00:21.74,Caption,,0,0,0,,sich flach an
Dialogue: 0,0:00:21.80,0:00:22.54,Caption,,0,0,0,,wie zu wenig.
Dialogue: 0,0:00:23.32,0:00:24.08,Caption,,0,0,0,,Deshalb hilft dir
Dialogue: 0,0:00:24.14,0:00:24.86,Caption,,0,0,0,,hier Wissen mehr
Dialogue: 0,0:00:24.92,0:00:25.54,Caption,,0,0,0,,als Kraft.
Dialogue: 0,0:00:26.34,0:00:27.62,Caption,,0,0,0,,Nicht dagegen ankämpfen.
Dialogue: 0,0:00:28.16,0:00:29.34,Caption,,0,0,0,,Langsam ausatmen.
Dialogue: 0,0:00:29.98,0:00:30.56,Caption,,0,0,0,,Dich auf einen
Dialogue: 0,0:00:30.66,0:00:31.36,Caption,,0,0,0,,einzigen Finger
Dialogue: 0,0:00:31.42,0:00:32.16,Caption,,0,0,0,,konzentrieren.
Dialogue: 0,0:00:32.82,0:00:33.32,Caption,,0,0,0,,Dann geht es
Dialogue: 0,0:00:33.38,0:00:33.88,Caption,,0,0,0,,vorüber.
Dialogue: 0,0:00:34.50,0:00:35.00,Caption,,0,0,0,,Wenn das oft
Dialogue: 0,0:00:35.06,0:00:36.10,Caption,,0,0,0,,passiert oder du
Dialogue: 0,0:00:36.16,0:00:37.34,Caption,,0,0,0,,tagsüber ständig müde
Dialogue: 0,0:00:37.40,0:00:38.34,Caption,,0,0,0,,bist, lass es
Dialogue: 0,0:00:38.42,0:00:39.56,Caption,,0,0,0,,ärztlich abklären.
Dialogue: 2,0:00:40.18,0:00:42.28,CtaHead,,0,0,0,,{\fad(280,0)}GANZE FOLGE IM KANAL
Dialogue: 2,0:00:40.32,0:00:42.28,CtaSub,,0,0,0,,{\fad(380,0)}Warum du jemanden im Zimmer spürst
