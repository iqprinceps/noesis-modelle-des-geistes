Dialogue: 2,0:00:00.00,0:00:01.75,Hook,,0,0,0,,DU ERSTICKST NICHT
Dialogue: 0,0:00:00.34,0:00:01.12,Caption,,0,0,0,,Du erstickst bei
Dialogue: 0,0:00:01.16,0:00:02.44,Caption,,0,0,0,,typischer Schlafparalyse
Dialogue: 0,0:00:02.48,0:00:03.48,Caption,,0,0,0,,nicht, obwohl dein
Dialogue: 0,0:00:03.54,0:00:04.56,Caption,,0,0,0,,Brustkorb bei vollem
Dialogue: 0,0:00:04.60,0:00:05.94,Caption,,0,0,0,,Bewusstsein Alarm\Nschreit.
Dialogue: 0,0:00:06.68,0:00:07.60,Caption,,0,0,0,,Die Lähmung betrifft
Dialogue: 0,0:00:07.68,0:00:09.32,Caption,,0,0,0,,willkürliche Muskeln,\Nwährend
Dialogue: 0,0:00:09.38,0:00:10.14,Caption,,0,0,0,,dein Zwerchfell
Dialogue: 0,0:00:10.20,0:00:11.02,Caption,,0,0,0,,weiterarbeitet.
Dialogue: 0,0:00:11.74,0:00:12.88,Caption,,0,0,0,,Genau dieser Widerspruch
Dialogue: 0,0:00:12.94,0:00:13.64,Caption,,0,0,0,,macht das Gefühl
Dialogue: 0,0:00:13.74,0:00:14.52,Caption,,0,0,0,,so überzeugend.
Dialogue: 0,0:00:15.24,0:00:16.48,Caption,,0,0,0,,Im REM-Schlaf verlieren
Dialogue: 0,0:00:16.54,0:00:17.58,Caption,,0,0,0,,besonders Haltungs- und
Dialogue: 0,0:00:17.66,0:00:19.06,Caption,,0,0,0,,Hilfsmuskeln spürbar\Nihren
Dialogue: 0,0:00:19.16,0:00:19.60,Caption,,0,0,0,,Tonus.
Dialogue: 0,0:00:20.22,0:00:21.22,Caption,,0,0,0,,Das Zwerchfell bleibt
Dialogue: 0,0:00:21.28,0:00:22.44,Caption,,0,0,0,,vergleichsweise aktiv.
Dialogue: 0,0:00:23.02,0:00:24.52,Caption,,0,0,0,,Doch flachere\NBrustbewegung
Dialogue: 0,0:00:24.58,0:00:25.62,Caption,,0,0,0,,plus Panik kann
Dialogue: 0,0:00:25.66,0:00:26.70,Caption,,0,0,0,,aus normaler Atmung
Dialogue: 0,0:00:26.78,0:00:28.04,Caption,,0,0,0,,subjektiv eine täuschend
Dialogue: 0,0:00:28.08,0:00:29.00,Caption,,0,0,0,,schwere Last machen.
Dialogue: 0,0:00:29.80,0:00:30.72,Caption,,0,0,0,,Darum hilft Wissen
Dialogue: 0,0:00:30.76,0:00:31.54,Caption,,0,0,0,,mehr als Kraft.
Dialogue: 0,0:00:32.16,0:00:33.56,Caption,,0,0,0,,Langsam ausatmen, den
Dialogue: 0,0:00:33.62,0:00:34.30,Caption,,0,0,0,,Blick ruhig auf
Dialogue: 0,0:00:34.34,0:00:35.32,Caption,,0,0,0,,einen kleinen Muskel
Dialogue: 0,0:00:35.38,0:00:36.32,Caption,,0,0,0,,richten und die
Dialogue: 0,0:00:36.38,0:00:37.78,Caption,,0,0,0,,Episode abklingen\Nlassen.
Dialogue: 0,0:00:38.50,0:00:39.70,Caption,,0,0,0,,Häufige Anfälle oder
Dialogue: 0,0:00:39.78,0:00:41.72,Caption,,0,0,0,,starke Tagesmüdigkeit\Ngehören
Dialogue: 0,0:00:41.78,0:00:43.38,Caption,,0,0,0,,trotzdem ärztlich\Nabgeklärt.
Dialogue: 1,0:00:41.12,0:00:43.92,CTA,,0,0,0,,Mehr: Schlafparalyse EP06
