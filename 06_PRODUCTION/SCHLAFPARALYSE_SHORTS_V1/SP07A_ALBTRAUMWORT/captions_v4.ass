Dialogue: 3,0:00:00.00,0:00:42.70,Badge,,0,0,0,,SCHLAFPARALYSE  ·  3/6
Dialogue: 4,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(160,260)}ALBTRAUM WAR\NEIN WESEN
Dialogue: 0,0:00:00.30,0:00:01.50,Caption,,0,0,0,,Albtraum hieß früher
Dialogue: 0,0:00:01.52,0:00:02.58,Caption,,0,0,0,,nicht schlechter Traum.
Dialogue: 0,0:00:03.22,0:00:03.98,Caption,,0,0,0,,Albtraum hieß:
Dialogue: 0,0:00:04.28,0:00:05.10,Caption,,0,0,0,,Da ist jemand.
Dialogue: 0,0:00:05.80,0:00:06.52,Caption,,0,0,0,,Die alte Mare
Dialogue: 0,0:00:06.58,0:00:07.32,Caption,,0,0,0,,war ein Wesen.
Dialogue: 0,0:00:07.84,0:00:08.64,Caption,,0,0,0,,Es kam nachts,
Dialogue: 0,0:00:08.92,0:00:09.58,Caption,,0,0,0,,setzte sich auf
Dialogue: 0,0:00:09.62,0:00:10.24,Caption,,0,0,0,,die Brust und
Dialogue: 0,0:00:10.28,0:00:10.72,Caption,,0,0,0,,drückte.
Dialogue: 0,0:00:11.46,0:00:12.14,Caption,,0,0,0,,Du warst wach,
Dialogue: 0,0:00:12.38,0:00:12.98,Caption,,0,0,0,,du konntest dich
Dialogue: 0,0:00:13.02,0:00:14.10,Caption,,0,0,0,,nicht bewegen, und
Dialogue: 0,0:00:14.14,0:00:14.78,Caption,,0,0,0,,dafür gab es
Dialogue: 0,0:00:14.84,0:00:15.50,Caption,,0,0,0,,einen Namen.
Dialogue: 0,0:00:16.20,0:00:17.20,Caption,,0,0,0,,Diesen Namen findest
Dialogue: 0,0:00:17.24,0:00:17.82,Caption,,0,0,0,,du quer durch
Dialogue: 0,0:00:17.88,0:00:19.16,Caption,,0,0,0,,die germanischen\NSprachen.
Dialogue: 0,0:00:19.72,0:00:21.46,Caption,,0,0,0,,Mara, Mare, Mahr.
Dialogue: 0,0:00:22.14,0:00:23.40,Caption,,0,0,0,,Im englischen Nightmare
Dialogue: 0,0:00:23.50,0:00:23.98,Caption,,0,0,0,,steckt er bis
Dialogue: 0,0:00:24.02,0:00:24.64,Caption,,0,0,0,,heute drin.
Dialogue: 0,0:00:25.28,0:00:25.96,Caption,,0,0,0,,Gemeint war nie
Dialogue: 0,0:00:26.02,0:00:26.62,Caption,,0,0,0,,ein Pferd.
Dialogue: 0,0:00:27.02,0:00:27.62,Caption,,0,0,0,,Gemeint war ein
Dialogue: 0,0:00:27.66,0:00:28.22,Caption,,0,0,0,,Besucher.
Dialogue: 0,0:00:28.80,0:00:29.34,Caption,,0,0,0,,Und jetzt das
Dialogue: 0,0:00:29.38,0:00:30.10,Caption,,0,0,0,,Erstaunliche:
Dialogue: 0,0:00:30.58,0:00:31.66,Caption,,0,0,0,,Die Beschreibung stimmt.
Dialogue: 0,0:00:32.30,0:00:33.38,Caption,,0,0,0,,Wachheit, Druck auf
Dialogue: 0,0:00:33.42,0:00:34.66,Caption,,0,0,0,,der Brust, Lähmung.
Dialogue: 0,0:00:35.36,0:00:36.02,Caption,,0,0,0,,Die Menschen haben
Dialogue: 0,0:00:36.06,0:00:37.24,Caption,,0,0,0,,genau festgehalten, was
Dialogue: 0,0:00:37.28,0:00:37.74,Caption,,0,0,0,,passiert.
Dialogue: 0,0:00:38.28,0:00:39.08,Caption,,0,0,0,,Nur die Erklärung
Dialogue: 0,0:00:39.14,0:00:39.92,Caption,,0,0,0,,war eine andere.
Dialogue: 2,0:00:40.60,0:00:42.70,CtaHead,,0,0,0,,{\fad(280,0)}GANZE FOLGE IM KANAL
Dialogue: 2,0:00:40.74,0:00:42.70,CtaSub,,0,0,0,,{\fad(380,0)}Salem 1692: Schlafparalyse als Hexerei
