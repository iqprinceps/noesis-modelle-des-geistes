Dialogue: 3,0:00:00.00,0:00:42.93,Badge,,0,0,0,,SCHLAFPARALYSE  ·  4/6
Dialogue: 4,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(160,260)}DER UNSICHTBARE\NZEUGE
Dialogue: 0,0:00:00.30,0:00:01.46,Caption,,0,0,0,,Der gefährlichste Zeuge
Dialogue: 0,0:00:01.52,0:00:02.18,Caption,,0,0,0,,in Salem war
Dialogue: 0,0:00:02.24,0:00:02.88,Caption,,0,0,0,,unsichtbar.
Dialogue: 0,0:00:03.70,0:00:04.72,Caption,,0,0,0,,Menschen sagten unter
Dialogue: 0,0:00:04.76,0:00:05.60,Caption,,0,0,0,,Eid aus, der
Dialogue: 0,0:00:05.64,0:00:06.90,Caption,,0,0,0,,Geist einer Angeklagten
Dialogue: 0,0:00:06.94,0:00:07.50,Caption,,0,0,0,,sei nachts in
Dialogue: 0,0:00:07.54,0:00:08.72,Caption,,0,0,0,,ihr Schlafzimmer\Ngekommen.
Dialogue: 0,0:00:09.26,0:00:10.16,Caption,,0,0,0,,Türen verschlossen.
Dialogue: 0,0:00:10.88,0:00:11.68,Caption,,0,0,0,,Niemand sonst hat
Dialogue: 0,0:00:11.74,0:00:12.50,Caption,,0,0,0,,etwas gesehen.
Dialogue: 0,0:00:12.98,0:00:13.68,Caption,,0,0,0,,Das Gericht hatte
Dialogue: 0,0:00:13.74,0:00:14.48,Caption,,0,0,0,,dafür sogar einen
Dialogue: 0,0:00:14.52,0:00:14.94,Caption,,0,0,0,,Begriff.
Dialogue: 0,0:00:15.42,0:00:16.52,Caption,,0,0,0,,Spectral evidence.
Dialogue: 0,0:00:16.92,0:00:17.74,Caption,,0,0,0,,Das Erlebnis als
Dialogue: 0,0:00:17.82,0:00:18.32,Caption,,0,0,0,,Beweis.
Dialogue: 0,0:00:18.92,0:00:19.86,Caption,,0,0,0,,Bei Bridget Bishop
Dialogue: 0,0:00:19.92,0:00:20.56,Caption,,0,0,0,,wurde das Teil
Dialogue: 0,0:00:20.60,0:00:21.34,Caption,,0,0,0,,der Anklage.
Dialogue: 0,0:00:21.96,0:00:22.66,Caption,,0,0,0,,Nicht der einzige
Dialogue: 0,0:00:22.76,0:00:23.72,Caption,,0,0,0,,Punkt, aber ein
Dialogue: 0,0:00:23.78,0:00:24.40,Caption,,0,0,0,,Teil davon.
Dialogue: 0,0:00:24.86,0:00:25.30,Caption,,0,0,0,,Und jetzt die
Dialogue: 0,0:00:25.36,0:00:25.78,Caption,,0,0,0,,Wendung:
Dialogue: 0,0:00:26.42,0:00:27.28,Caption,,0,0,0,,Selbst damals war
Dialogue: 0,0:00:27.32,0:00:28.08,Caption,,0,0,0,,das umstritten.
Dialogue: 0,0:00:28.66,0:00:29.86,Caption,,0,0,0,,Diese Beweisform galt
Dialogue: 0,0:00:29.90,0:00:30.92,Caption,,0,0,0,,nur wenige Monate.
Dialogue: 0,0:00:31.40,0:00:32.08,Caption,,0,0,0,,Salem ist nicht
Dialogue: 0,0:00:32.14,0:00:33.50,Caption,,0,0,0,,durchgedreht, weil\NMenschen
Dialogue: 0,0:00:33.56,0:00:34.44,Caption,,0,0,0,,nachts etwas erlebt
Dialogue: 0,0:00:34.54,0:00:34.78,Caption,,0,0,0,,haben.
Dialogue: 0,0:00:35.56,0:00:36.20,Caption,,0,0,0,,Sondern weil ein
Dialogue: 0,0:00:36.24,0:00:37.72,Caption,,0,0,0,,Gericht entschied,\Nprivate
Dialogue: 0,0:00:37.80,0:00:38.96,Caption,,0,0,0,,Gewissheit als\Nöffentliche
Dialogue: 0,0:00:39.08,0:00:40.24,Caption,,0,0,0,,Tatsache zu behandeln.
Dialogue: 2,0:00:40.83,0:00:42.93,CtaHead,,0,0,0,,{\fad(280,0)}GANZE FOLGE IM KANAL
Dialogue: 2,0:00:40.97,0:00:42.93,CtaSub,,0,0,0,,{\fad(380,0)}Salem 1692: Schlafparalyse als Hexerei
